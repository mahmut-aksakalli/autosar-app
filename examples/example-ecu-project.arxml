<?xml version="1.0" encoding="utf-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ExampleEcuProject</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Interfaces</SHORT-NAME>
          <ELEMENTS>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>SpeedSignal_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VehicleSpeed</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PedalPosition_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>PedalPosition</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>TemperatureSignal_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>TemperatureValue</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>TorqueRequest_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>RequestedTorque</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PressureSignal_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>BoostPressure</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>DiagnosticStatus_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>FaultState</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>ActuatorCommand_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ThrottleDuty</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PositionFeedback_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ActuatorPosition</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>HealthStatus_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>HealthState</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>EventSignal_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>EventCode</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>FaultCounter_I</SHORT-NAME>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>FaultCounter</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>CalibrationService_I</SHORT-NAME>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ReadCalibration</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>SensorSyncService_I</SHORT-NAME>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SynchronizeSensor</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>FaultMemoryService_I</SHORT-NAME>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>StoreFault</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>DiagnosticsControl_I</SHORT-NAME>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RunSelfTest</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>HealthMonitorService_I</SHORT-NAME>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>QueryHealth</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>ActuationControlService_I</SHORT-NAME>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>EnableActuation</SHORT-NAME>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
            </CLIENT-SERVER-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>DataTypes</SHORT-NAME>
          <ELEMENTS>
            <APPLICATION-PRIMITIVE-DATA-TYPE>
              <SHORT-NAME>uint8</SHORT-NAME>
            </APPLICATION-PRIMITIVE-DATA-TYPE>
            <APPLICATION-PRIMITIVE-DATA-TYPE>
              <SHORT-NAME>uint16</SHORT-NAME>
            </APPLICATION-PRIMITIVE-DATA-TYPE>
            <APPLICATION-PRIMITIVE-DATA-TYPE>
              <SHORT-NAME>uint32</SHORT-NAME>
            </APPLICATION-PRIMITIVE-DATA-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>ImplementationDataTypes</SHORT-NAME>
          <ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>DiagAdminRequestContext</SHORT-NAME>
            </IMPLEMENTATION-DATA-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Modes</SHORT-NAME>
          <ELEMENTS>
            <MODE-DECLARATION-GROUP>
              <SHORT-NAME>PowerModeGroup</SHORT-NAME>
              <INITIAL-MODE-REF DEST="MODE-DECLARATION">/ExampleEcuProject/Modes/PowerModeGroup/POWER_ON</INITIAL-MODE-REF>
              <MODE-DECLARATIONS>
                <MODE-DECLARATION>
                  <SHORT-NAME>POWER_ON</SHORT-NAME>
                </MODE-DECLARATION>
                <MODE-DECLARATION>
                  <SHORT-NAME>LOW_POWER</SHORT-NAME>
                </MODE-DECLARATION>
                <MODE-DECLARATION>
                  <SHORT-NAME>SLEEP</SHORT-NAME>
                </MODE-DECLARATION>
              </MODE-DECLARATIONS>
            </MODE-DECLARATION-GROUP>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Components</SHORT-NAME>
          <ELEMENTS>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SpeedSensorSwc</SHORT-NAME>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>SpeedOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/SpeedSignal_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PedalPositionOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/PedalPosition_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>TemperatureOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/TemperatureSignal_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>CalibrationSrv</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/CalibrationService_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>SensorSyncSrv</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/SensorSyncService_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>EventIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/EventSignal_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>FaultCounterIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/FaultCounter_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>FaultMemoryClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/FaultMemoryService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>HealthMonitorClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/HealthMonitorService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>ActuationControlClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/ActuationControlService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>SpeedSensorBehavior</SHORT-NAME>
                  <RUNNABLES>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>AcquireSignals</SHORT-NAME>
                      <MINIMUM-START-INTERVAL>0.01</MINIMUM-START-INTERVAL>
                    </RUNNABLE-ENTITY>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>PublishSignals</SHORT-NAME>
                      <MINIMUM-START-INTERVAL>0.01</MINIMUM-START-INTERVAL>
                    </RUNNABLE-ENTITY>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>HandleSensorEvents</SHORT-NAME>
                      <MINIMUM-START-INTERVAL>0.05</MINIMUM-START-INTERVAL>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>AcquireSignalsEvent</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ExampleEcuProject/Components/SpeedSensorSwc/SpeedSensorBehavior/AcquireSignals</START-ON-EVENT-REF>
                      <PERIOD>0.01</PERIOD>
                    </TIMING-EVENT>
                    <TIMING-EVENT>
                      <SHORT-NAME>PublishSignalsEvent</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ExampleEcuProject/Components/SpeedSensorSwc/SpeedSensorBehavior/PublishSignals</START-ON-EVENT-REF>
                      <PERIOD>0.02</PERIOD>
                    </TIMING-EVENT>
                    <DATA-RECEIVED-EVENT>
                      <SHORT-NAME>HandleSensorEventTrigger</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ExampleEcuProject/Components/SpeedSensorSwc/SpeedSensorBehavior/HandleSensorEvents</START-ON-EVENT-REF>
                    </DATA-RECEIVED-EVENT>
                  </EVENTS>
                  <PARAMETER-DATA-PROTOTYPES>
                    <PARAMETER-DATA-PROTOTYPE>
                      <SHORT-NAME>SpeedScale_C</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                      <INIT-VALUE>1000</INIT-VALUE>
                    </PARAMETER-DATA-PROTOTYPE>
                    <PARAMETER-DATA-PROTOTYPE>
                      <SHORT-NAME>TemperatureOffset_C</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                      <INIT-VALUE>25</INIT-VALUE>
                    </PARAMETER-DATA-PROTOTYPE>
                  </PARAMETER-DATA-PROTOTYPES>
                  <INTER-RUNNABLE-VARIABLES>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>RawSpeed_Irv</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>FilteredTemperature_Irv</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                  </INTER-RUNNABLE-VARIABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>TorqueControllerSwc</SHORT-NAME>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>SpeedIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/SpeedSignal_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>PedalPositionIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/PedalPosition_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>TemperatureIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/TemperatureSignal_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>CalibrationClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/CalibrationService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>SensorSyncClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/SensorSyncService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>DiagnosticsControlClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/DiagnosticsControl_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>FaultMemoryClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/FaultMemoryService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>TorqueOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/TorqueRequest_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PressureOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/PressureSignal_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DiagOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/DiagnosticStatus_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>EventIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/EventSignal_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>FaultCounterIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/FaultCounter_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>TorqueControllerBehavior</SHORT-NAME>
                  <RUNNABLES>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>ReadInputs</SHORT-NAME>
                      <MINIMUM-START-INTERVAL>0.01</MINIMUM-START-INTERVAL>
                    </RUNNABLE-ENTITY>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>ComputeTorque</SHORT-NAME>
                      <MINIMUM-START-INTERVAL>0.01</MINIMUM-START-INTERVAL>
                    </RUNNABLE-ENTITY>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>PublishControlOutputs</SHORT-NAME>
                      <MINIMUM-START-INTERVAL>0.02</MINIMUM-START-INTERVAL>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>ReadInputsEvent</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ExampleEcuProject/Components/TorqueControllerSwc/TorqueControllerBehavior/ReadInputs</START-ON-EVENT-REF>
                      <PERIOD>0.01</PERIOD>
                    </TIMING-EVENT>
                    <TIMING-EVENT>
                      <SHORT-NAME>ComputeTorqueEvent</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ExampleEcuProject/Components/TorqueControllerSwc/TorqueControllerBehavior/ComputeTorque</START-ON-EVENT-REF>
                      <PERIOD>0.01</PERIOD>
                    </TIMING-EVENT>
                    <DATA-RECEIVED-EVENT>
                      <SHORT-NAME>PublishControlOutputsEvent</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ExampleEcuProject/Components/TorqueControllerSwc/TorqueControllerBehavior/PublishControlOutputs</START-ON-EVENT-REF>
                    </DATA-RECEIVED-EVENT>
                  </EVENTS>
                  <PARAMETER-DATA-PROTOTYPES>
                    <PARAMETER-DATA-PROTOTYPE>
                      <SHORT-NAME>TorqueGain_C</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                      <INIT-VALUE>320</INIT-VALUE>
                    </PARAMETER-DATA-PROTOTYPE>
                    <PARAMETER-DATA-PROTOTYPE>
                      <SHORT-NAME>PressureLimit_C</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                      <INIT-VALUE>1800</INIT-VALUE>
                    </PARAMETER-DATA-PROTOTYPE>
                  </PARAMETER-DATA-PROTOTYPES>
                  <INTER-RUNNABLE-VARIABLES>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>RequestedTorque_Irv</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint16</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>DiagnosticState_Irv</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ExampleEcuProject/DataTypes/uint8</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                  </INTER-RUNNABLE-VARIABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>ThrottleActuatorSwc</SHORT-NAME>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>TorqueIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/TorqueRequest_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>PressureIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/PressureSignal_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>DiagStatusIn</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/DiagnosticStatus_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>HealthMonitorClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/HealthMonitorService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>ActuationControlClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/ActuationControlService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>CalibrationClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/CalibrationService_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>DiagnosticsControlClient</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/ExampleEcuProject/Interfaces/DiagnosticsControl_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>ActuatorOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/ActuatorCommand_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PositionFeedbackOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/PositionFeedback_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>HealthStatusOut</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/ExampleEcuProject/Interfaces/HealthStatus_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
