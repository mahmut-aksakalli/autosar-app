{
  "name": "autosar-model-view",
  "displayName": "AUTOSAR Model View",
  "description": "VS Code extension for exploring AUTOSAR software component and composition models.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:autosarModelView.tree"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autosarModelView.open",
        "title": "AUTOSAR: Show Model View for Workspace",
        "icon": "$(preview)"
      },
      {
        "command": "autosarModelView.openFile",
        "title": "AUTOSAR: Show Model View for Single File"
      },
      {
        "command": "autosarModelView.refresh",
        "title": "AUTOSAR: Refresh Model View",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autosarModelView.refresh",
          "when": "view == autosarModelView.tree",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "autosarModelView.openFile",
          "when": "resourceExtname == .arxml",
          "group": "navigation@50"
        }
      ],
      "editor/title/context": [
        {
          "command": "autosarModelView.openFile",
          "when": "resourceExtname == .arxml",
          "group": "navigation@50"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autosarModelView",
          "title": "AUTOSAR",
          "icon": "resources/autosar.svg"
        }
      ]
    },
    "views": {
      "autosarModelView": [
        {
          "id": "autosarModelView.tree",
          "name": "Model",
          "icon": "resources/autosar.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "tsc -p ./tsconfig.json",
    "compile:webview": "vite build --config webview/vite.config.ts",
    "package": "npm run compile && vsce package",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "fast-xml-parser": "^4.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
